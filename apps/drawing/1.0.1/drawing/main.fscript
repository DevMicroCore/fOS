-- Kleine Zeichen-App als Beispiel fuer Canvas und Pointer-Ereignisse.

var last_x = 0
var last_y = 0
var drawing_active = false

function show_position(x, y)
  lbl_position.text = "x: " + x + "\ny: " + y
end

function clear_drawing()
  drawing.clear(16777215)
  drawing.draw_text(14, 12, "Mit dem Finger zeichnen", 4210752, 20)
end

on app.start
  clear_drawing()
end

on btn_clear.click
  clear_drawing()
end

on drawing.pointer_down
  last_x = event_x()
  last_y = event_y()
  drawing_active = true
  drawing.circle(last_x, last_y, 2, 0, true)
  show_position(last_x, last_y)
end

on drawing.pointer_move
  var x = event_x()
  var y = event_y()
  if drawing_active and event_pressed() then
    drawing.line(last_x, last_y, x, y, 0, 4)
    last_x = x
    last_y = y
    show_position(x, y)
  end
end

on drawing.pointer_up
  drawing_active = false
  show_position(event_x(), event_y())
end

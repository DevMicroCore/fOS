# Exact fScript recreation of the supplied SquareLine ui_Weather.c geometry.
type=panel;x=0;y=0;w=800;h=480;bg=0x0D1217;border=0;radius=0;clickable=false;scrollable=false
type=label;id=lbl_temperature;x=200;y=21;w=400;h=50;text=--°C   --%;fg=0xFFFFFF;font=40;align=center
type=label;id=lbl_information;x=70;y=82;w=660;h=52;text=No weather data found;fg=0xFFFFFF;font=40;align=center
type=roller;id=roller_forecast;x=20;y=178;w=760;h=281;text=No Data;bg=0x28272F;fg=0xFFFFFF;font=20;radius=9;border=0
type=button;id=btn_open_search;x=665;y=5;w=119;h=50;text=Search;bg=theme;fg=0x000000;font=24;radius=7;border=0;scrollable=false

# Full-screen search layer from ui_Weather.c.
type=panel;id=panel_search;x=0;y=1;w=800;h=480;bg=0x000000;border=0;radius=0;styleless=true;clickable=false;scrollable=false;hidden=true
type=textarea;id=txt_search;parent=panel_search;x=16;y=64;w=767;h=70;text=;placeholder=Search for a place ...;one_line=true;max_length=48;bg=0x28272F;fg=0xFFFFFF;font=20
type=dropdown;id=dropdown_places;parent=panel_search;x=16;y=138;w=767;h=50;text=Current Location;bg=0x28272F;fg=0xFFFFFF;font=20
type=keyboard;id=keyboard_search;x=0;y=277;w=800;h=197;target=txt_search;font=20;hidden=true
type=button;id=btn_confirm;parent=panel_search;x=665;y=5;w=119;h=50;text=Confirm;bg=theme;fg=0x000000;font=24;radius=7;border=0;scrollable=false

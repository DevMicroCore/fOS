-- fScript recreation of the native fOS weather app.
-- The geometry lives in layout.ui; this file only supplies behaviour and data.

var latitude = ""
var longitude = ""
var location_name = "Current Location"
var refresh_minutes = 0
var weather_ready = false
var candidate_count = 0

var candidate_1_name = ""
var candidate_1_lat = ""
var candidate_1_lon = ""
var candidate_2_name = ""
var candidate_2_lat = ""
var candidate_2_lon = ""
var candidate_3_name = ""
var candidate_3_lat = ""
var candidate_3_lon = ""
var candidate_4_name = ""
var candidate_4_lat = ""
var candidate_4_lon = ""
var candidate_5_name = ""
var candidate_5_lat = ""
var candidate_5_lon = ""
var candidate_6_name = ""
var candidate_6_lat = ""
var candidate_6_lon = ""

function weather_text(code)
  if code == "0" then
    return "clear"
  end
  if code == "1" or code == "2" or code == "3" then
    return "cloudy"
  end
  if code == "45" or code == "48" then
    return "fog"
  end
  if code == "51" or code == "53" or code == "55" then
    return "drizzle"
  end
  if code == "56" or code == "57" then
    return "freezing drizzle"
  end
  if code == "61" or code == "63" or code == "65" then
    return "rain"
  end
  if code == "66" or code == "67" then
    return "freezing rain"
  end
  if code == "71" or code == "73" or code == "75" or code == "77" then
    return "snow"
  end
  if code == "80" or code == "81" or code == "82" then
    return "showers"
  end
  if code == "85" or code == "86" then
    return "snow showers"
  end
  if code == "95" or code == "96" or code == "99" then
    return "thunderstorm"
  end
  return "unknown"
end

function forecast_text(code)
  if code == "0" then
    return "clear"
  end
  if code == "1" or code == "2" or code == "3" then
    return "clouds"
  end
  if code == "45" or code == "48" then
    return "fog"
  end
  if code == "51" or code == "53" or code == "55" or code == "56" or code == "57" then
    return "drizzle"
  end
  if code == "61" or code == "63" or code == "65" or code == "66" or code == "67" then
    return "rain"
  end
  if code == "71" or code == "73" or code == "75" or code == "77" or code == "85" or code == "86" then
    return "snow"
  end
  if code == "80" or code == "81" or code == "82" then
    return "showers"
  end
  if code == "95" or code == "96" or code == "99" then
    return "storm"
  end
  return "unknown"
end

function daily_line(index)
  var date = http_json("daily.time[" + index + "]")
  var low = http_json("daily.temperature_2m_min[" + index + "]")
  var high = http_json("daily.temperature_2m_max[" + index + "]")
  var code = http_json("daily.weather_code[" + index + "]")
  return date_weekday(date) + " " + string_slice(date, 5, 10) + " " + low + "/" + high + "C " + forecast_text(code)
end

function fetch_weather()
  weather_ready = false
  lbl_information.text = "Loading weather ..."

  var current_url = "https://api.open-meteo.com/v1/forecast?latitude=" + latitude + "&longitude=" + longitude + "&current=temperature_2m,relative_humidity_2m,weather_code&timezone=auto"
  var current_ok = http_get(current_url)
  if current_ok == false then
    lbl_information.text = "No weather data found"
    return
  end

  var temperature = http_json("current.temperature_2m")
  var humidity = http_json("current.relative_humidity_2m")
  var current_code = http_json("current.weather_code")
  lbl_temperature.text = temperature + "°C   " + humidity + "%"
  lbl_information.text = weather_text(current_code) + " | " + location_name

  var daily_url = "https://api.open-meteo.com/v1/forecast?latitude=" + latitude + "&longitude=" + longitude + "&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=7"
  var daily_ok = http_get(daily_url)
  if daily_ok == false then
    roller_forecast.text = "No forecast data"
    return
  end

  roller_forecast.text = daily_line(0) + "\n" + daily_line(1) + "\n" + daily_line(2) + "\n" + daily_line(3) + "\n" + daily_line(4) + "\n" + daily_line(5) + "\n" + daily_line(6)
  roller_forecast.value = 0
  weather_ready = true
  refresh_minutes = 0
end

function load_current_location()
  lbl_information.text = "Finding current location ..."
  var located = http_get("http://ip-api.com/json/?fields=status,city,country,lat,lon")
  if located == false then
    lbl_information.text = "Current location unavailable"
    weather_ready = false
    return
  end
  latitude = http_json("lat")
  longitude = http_json("lon")
  location_name = http_json("city") + ", " + http_json("country")
  fetch_weather()
end

function clear_candidates()
  candidate_count = 0
  candidate_1_name = ""
  candidate_1_lat = ""
  candidate_1_lon = ""
  candidate_2_name = ""
  candidate_2_lat = ""
  candidate_2_lon = ""
  candidate_3_name = ""
  candidate_3_lat = ""
  candidate_3_lon = ""
  candidate_4_name = ""
  candidate_4_lat = ""
  candidate_4_lon = ""
  candidate_5_name = ""
  candidate_5_lat = ""
  candidate_5_lon = ""
  candidate_6_name = ""
  candidate_6_lat = ""
  candidate_6_lon = ""
end

function find_locations(query)
  clear_candidates()
  dropdown_places.text = "Current Location"
  dropdown_places.value = 0
  if query == "" then
    return
  end

  var search_url = "https://geocoding-api.open-meteo.com/v1/search?name=" + url_encode(query) + "&count=6&language=en&format=json"
  var found = http_get(search_url)
  if found == false then
    dropdown_places.text = "Current Location\nNo results"
    return
  end

  var options = "Current Location"
  var name = http_json("results[0].name")
  if name != "" then
    candidate_1_name = name + ", " + http_json("results[0].country")
    candidate_1_lat = http_json("results[0].latitude")
    candidate_1_lon = http_json("results[0].longitude")
    options = options + "\n" + candidate_1_name
    candidate_count = 1
  end
  name = http_json("results[1].name")
  if name != "" then
    candidate_2_name = name + ", " + http_json("results[1].country")
    candidate_2_lat = http_json("results[1].latitude")
    candidate_2_lon = http_json("results[1].longitude")
    options = options + "\n" + candidate_2_name
    candidate_count = 2
  end
  name = http_json("results[2].name")
  if name != "" then
    candidate_3_name = name + ", " + http_json("results[2].country")
    candidate_3_lat = http_json("results[2].latitude")
    candidate_3_lon = http_json("results[2].longitude")
    options = options + "\n" + candidate_3_name
    candidate_count = 3
  end
  name = http_json("results[3].name")
  if name != "" then
    candidate_4_name = name + ", " + http_json("results[3].country")
    candidate_4_lat = http_json("results[3].latitude")
    candidate_4_lon = http_json("results[3].longitude")
    options = options + "\n" + candidate_4_name
    candidate_count = 4
  end
  name = http_json("results[4].name")
  if name != "" then
    candidate_5_name = name + ", " + http_json("results[4].country")
    candidate_5_lat = http_json("results[4].latitude")
    candidate_5_lon = http_json("results[4].longitude")
    options = options + "\n" + candidate_5_name
    candidate_count = 5
  end
  name = http_json("results[5].name")
  if name != "" then
    candidate_6_name = name + ", " + http_json("results[5].country")
    candidate_6_lat = http_json("results[5].latitude")
    candidate_6_lon = http_json("results[5].longitude")
    options = options + "\n" + candidate_6_name
    candidate_count = 6
  end

  dropdown_places.text = options
  if candidate_count > 0 then
    dropdown_places.value = 1
  end
end

function apply_candidate(index)
  if index == 1 then
    location_name = candidate_1_name
    latitude = candidate_1_lat
    longitude = candidate_1_lon
  end
  if index == 2 then
    location_name = candidate_2_name
    latitude = candidate_2_lat
    longitude = candidate_2_lon
  end
  if index == 3 then
    location_name = candidate_3_name
    latitude = candidate_3_lat
    longitude = candidate_3_lon
  end
  if index == 4 then
    location_name = candidate_4_name
    latitude = candidate_4_lat
    longitude = candidate_4_lon
  end
  if index == 5 then
    location_name = candidate_5_name
    latitude = candidate_5_lat
    longitude = candidate_5_lon
  end
  if index == 6 then
    location_name = candidate_6_name
    latitude = candidate_6_lat
    longitude = candidate_6_lon
  end
  if latitude != "" and longitude != "" then
    fetch_weather()
  end
end

on app.start
  panel_search.hidden = true
  keyboard_search.hidden = true
  dropdown_places.text = "Current Location"
  dropdown_places.value = 0
  load_current_location()
end

on btn_open_search.click
  dropdown_places.text = "Current Location"
  dropdown_places.value = 0
  panel_search.hidden = false
  keyboard_search.hidden = false
  txt_search.focus()
end

on keyboard_search.ready
  find_locations(txt_search.text)
  keyboard_search.hidden = false
end

on keyboard_search.cancel
  keyboard_search.hidden = true
  panel_search.hidden = true
  txt_search.blur()
end

on btn_confirm.click
  var selected = dropdown_places.value
  keyboard_search.hidden = true
  panel_search.hidden = true
  txt_search.blur()
  if selected == 0 then
    load_current_location()
  else
    apply_candidate(selected)
  end
end

on app.timer
  refresh_minutes = refresh_minutes + 1
  if weather_ready == false or refresh_minutes >= 15 then
    fetch_weather()
  end
end

on app.theme_changed
end

on app.close
  keyboard_search.hidden = true
  clear_candidates()
  latitude = ""
  longitude = ""
  location_name = ""
  weather_ready = false
end

  "uiFields": {
    "type": {
      "doc": "LVGL widget type.",
      "values": [
        "label",
        "button",
        "textarea",
        "switch",
        "checkbox",
        "panel",
        "roller",
        "dropdown",
        "keyboard",
        "canvas",
        "slider",
        "tabview",
        "tab"
      ]
    },
    "id": {
      "doc": "Unique fScript ID: starts with a letter or underscore, followed by letters, underscores, or digits."
    },
    "parent": {
      "doc": "ID of a previously declared parent object. A tab requires a tabview parent."
    },
    "target": {
      "doc": "Text area ID for a keyboard; may be declared later.",
      "types": [
        "keyboard"
      ]
    },
    "x": {
      "doc": "X position relative to the parent object."
    },
    "y": {
      "doc": "Y position relative to the parent object."
    },
    "w": {
      "doc": "Width in pixels."
    },
    "h": {
      "doc": "Height in pixels."
    },
    "text": {
      "doc": "Text or options; use \\n for line breaks. A semicolon ends the field."
    },
    "placeholder": {
      "doc": "Placeholder text.",
      "types": [
        "textarea"
      ]
    },
    "bg": {
      "doc": "Background color as 0xRRGGBB or a theme name.",
      "values": [
        "theme",
        "surface",
        "0x000000",
        "0xFFFFFF"
      ]
    },
    "fg": {
      "doc": "Text color as 0xRRGGBB or a theme name.",
      "values": [
        "contrast",
        "theme",
        "0x000000",
        "0xFFFFFF"
      ]

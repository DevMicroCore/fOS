{
  "version": "fOS 4.0.1 / fosc 0.14.0",
  "builtins": [
    {
      "name": "http_get",
      "params": [
        {
          "name": "url",
          "type": "String",
          "default": "\"https://example.com\""
        }
      ],
      "result": "Boolean",
      "doc": "Fetches an HTTP/HTTPS resource. Read the response with http_json or http_text.",
      "permission": "network"
    },
    {
      "name": "http_status",
      "params": [],
      "result": "Integer",
      "doc": "HTTP status code of the last request.",
      "permission": "network"
    },
    {
      "name": "http_json",
      "params": [
        {
          "name": "path",
          "type": "String",
          "default": "\"results[0].name\""
        }
      ],
      "result": "String",
      "doc": "Reads a scalar value using a JSON path.",
      "permission": "network"
    },
    {
      "name": "http_text",
      "params": [
        {
          "name": "offset",
          "type": "Integer",
          "default": "0"
        }
      ],
      "result": "String",
      "doc": "Reads up to 255 bytes from the last HTTP response, starting at offset.",
      "permission": "network"
    },
    {
      "name": "url_encode",
      "params": [
        {
          "name": "text",
          "type": "String",
          "default": "\"Berlin\""
        }
      ],
      "result": "String",
      "doc": "Encodes text for use in a URL.",
      "permission": "network"
    },
    {
      "name": "date_weekday",
      "params": [
        {
          "name": "iso_date",
          "type": "String",
          "default": "\"2026-10-14\""
        }
      ],
      "result": "String",
      "doc": "Returns the weekday for YYYY-MM-DD, from Mon to Sun.",
      "permission": ""
    },
    {
      "name": "file_read",
      "params": [
        {
          "name": "path",
          "type": "String",
          "default": "\"appdata/state.txt\""
        }
      ],
      "result": "String",
      "doc": "Reads up to 255 bytes. Returns an empty string if the file is missing or too large.",
      "permission": "storage.read:<folder>"
    },
    {
      "name": "file_write",
      "params": [
        {
          "name": "path",
          "type": "String",
          "default": "\"appdata/state.txt\""
        },
        {
          "name": "data",
          "type": "String",
          "default": "\"\""
        }
      ],
      "result": "Boolean",
      "doc": "Replaces a file with the supplied content.",
      "permission": "storage.write:<folder>"
    },
    {
      "name": "file_list",
      "params": [
        {
          "name": "path",
          "type": "String",
          "default": "\"/music/files\""
        }
      ],
      "result": "String",
      "doc": "Returns a limited directory listing; folder names end with /. Use roller.load_dir for longer lists.",
      "permission": "storage.read:<folder>"
    },
    {
      "name": "file_pair_value",
      "params": [
        {
          "name": "path",
          "type": "String",
          "default": "\"/music/webradio/webradio.txt\""
        },
        {
          "name": "separator",
          "type": "String",
          "default": "\"|\""
        },
        {
          "name": "index",
          "type": "Integer",
          "default": "0"
        }
      ],
      "result": "String",
      "doc": "Returns the value of a valid name/value row using a zero-based index. Uses the same indices as roller.load_pairs.",
      "permission": "storage.read:<folder>"
    },
    {
      "name": "audio_play",
      "params": [
        {
          "name": "path",
          "type": "String",
          "default": "\"/music/files/song.mp3\""
        }
      ],
      "result": "Boolean",
      "doc": "Starts playback of a local file allowed by the storage scope.",
      "permission": "audio, readable storage path"
    },
    {
      "name": "audio_stream",
      "params": [
        {
          "name": "url",
          "type": "String",
          "default": "\"https://example.com/stream\""
        }
      ],
      "result": "Boolean",
      "doc": "Starts an HTTP/HTTPS audio stream. Returns false if Wi-Fi is unavailable, OTA is active, or playback cannot start.",
      "permission": "audio, network"
    },
    {
      "name": "audio_stop",
      "params": [],
      "result": "Boolean",
      "doc": "Stops playback owned by the active fApp.",
      "permission": "audio"
    },
    {
      "name": "audio_set_volume",
      "params": [
        {
          "name": "value",
          "type": "Integer",
          "default": "15"
        }
      ],
      "result": "Boolean",
      "doc": "Sets the volume to an integer from 0 to 21.",
      "permission": "audio"
    },
    {
      "name": "audio_volume",
      "params": [],
      "result": "Integer",
      "doc": "Returns the current volume (0–21).",
      "permission": "audio"
    },
    {
      "name": "audio_playing",
      "params": [],
      "result": "Boolean",
      "doc": "Returns whether audio owned by the fApp is playing. Returns false at the end of a file.",
      "permission": "audio"
    },
    {
      "name": "audio_position",
      "params": [],
      "result": "Integer",
      "doc": "Returns the current local file position in seconds, or 0 for other sources.",
      "permission": "audio"
    },
    {
      "name": "audio_duration",
      "params": [],
      "result": "Integer",
      "doc": "Returns the local file duration in seconds; 0 for streams or an unknown duration.",
      "permission": "audio"
    },
    {
      "name": "audio_seek",
      "params": [
        {
          "name": "seconds",
          "type": "Integer",
          "default": "0"
        }
      ],
      "result": "Boolean",
      "doc": "Seeks an active local file to a position from 0 to 65535 seconds.",
      "permission": "audio"
    },
    {
      "name": "wifi_status",
      "params": [],
      "result": "Boolean",
      "doc": "Returns whether Wi-Fi is connected.",
      "permission": "network"
    },
    {
      "name": "system.restart",
      "params": [],
      "result": "nil",
      "doc": "Requests a controlled system restart.",
      "permission": "system.restart"
    },
    {
      "name": "timer.start",
      "params": [
        {
          "name": "milliseconds",
          "type": "Integer",
          "default": "200"
        }
      ],
      "result": "Boolean",
      "doc": "Changes the recurring app.timer interval (100–86400000 ms).",
      "permission": ""
    },
    {
      "name": "Serial.printf",
      "params": [
        {
          "name": "text",
          "type": "String",
          "default": "\"Hello fOS\\n\""
        }
      ],
      "result": "nil",
      "doc": "Prints one composed string; printf format arguments are not supported.",
      "permission": ""
    },
    {
      "name": "text",
      "params": [
        {
          "name": "value",
          "type": "Any",
          "default": "value"
        }
      ],
      "result": "String",
      "doc": "Converts a value to text.",
      "permission": ""
    },
    {
      "name": "number_parse",
      "params": [
        {
          "name": "text",
          "type": "String",
          "default": "\"12,5\""
        }
      ],
      "result": "Float",
      "doc": "Converts numeric text to a number; also accepts a decimal comma.",
      "permission": ""
    },
    {
      "name": "round",
      "params": [
        {
          "name": "number",
          "type": "Number",
          "default": "12.5"
        }
      ],
      "result": "Integer",
      "doc": "Rounds to the nearest integer.",
      "permission": ""
    },
    {
      "name": "string_length",
      "params": [
        {
          "name": "text",
          "type": "String",
          "default": "\"Hello\""
        }
      ],
      "result": "Integer",
      "doc": "Returns the length of a string in bytes.",
      "permission": ""
    },
    {
      "name": "string_slice",
      "params": [
        {
          "name": "text",
          "type": "String",
          "default": "\"Hello\""
        },
        {
          "name": "start",
          "type": "Integer",
          "default": "0"
        },
        {
          "name": "length",
          "type": "Integer",
          "default": "5"
        }
      ],
      "result": "String",
      "doc": "Returns a substring starting at a byte index; negative start values count from the end.",
      "permission": ""
    },
    {
      "name": "string_last_index",
      "params": [
        {
          "name": "text",
          "type": "String",
          "default": "\"/music/files/song.mp3\""
        },
        {
          "name": "needle",
          "type": "String",
          "default": "\"/\""
        }
      ],
      "result": "Integer",
      "doc": "Returns the zero-based index of the last match, or -1 if not found.",
      "permission": ""
    },
    {
      "name": "math_eval",
      "params": [
        {
          "name": "expression",
          "type": "String",
          "default": "\"2+3*4\""
        }
      ],
      "result": "String",
      "doc": "Evaluates a mathematical expression; reports errors as Math Error.",
      "permission": ""
    },
    {
      "name": "event_x",
      "params": [],
      "result": "Integer",
      "doc": "Returns the local X coordinate of the current pointer event.",
      "permission": ""
    },
    {
      "name": "event_y",
      "params": [],
      "result": "Integer",
      "doc": "Returns the local Y coordinate of the current pointer event.",
      "permission": ""
    },
    {
      "name": "event_screen_x",
      "params": [],
      "result": "Integer",
      "doc": "Returns the absolute screen X coordinate of the pointer event.",
      "permission": ""
    },
    {
      "name": "event_screen_y",
      "params": [],
      "result": "Integer",
      "doc": "Returns the absolute screen Y coordinate of the pointer event.",
      "permission": ""
    },
    {
      "name": "event_pressed",
      "params": [],
      "result": "Boolean",
      "doc": "Returns whether the pointer is pressed in the current pointer event.",
      "permission": ""
    }
  ],

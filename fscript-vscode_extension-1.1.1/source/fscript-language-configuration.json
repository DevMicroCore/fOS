{
  "comments": {
    "lineComment": "--",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:function|on)\\b.*|(?:if|elseif|while|for)\\b.*\\bthen\\s*|else\\s*)(?:--.*)?$",
    "decreaseIndentPattern": "^\\s*(?:end|else|elseif)\\b"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}

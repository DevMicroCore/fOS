var counter = 0

function show_counter()
    lbl_status.text = "Klicks: " + counter
end

on app.start
    lbl_title.text = "fScript laeuft"
    show_counter()
end

on btn_add.click
    counter = counter + 1
    show_counter()
end

on btn_reset.click
    counter = 0
    show_counter()
end

on app.theme_changed
    lbl_title.text = "Theme gewechselt"
end

on app.close
    counter = 0
end
